{
  // biomeを無効化
  "biome.enabled": false,
  // 自動保存を有効化
  "editor.formatOnSave": true,
  // Prettierをデフォルトのフォーマッタに設定
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // eslintのpathを指定
  "eslint.workingDirectories": ["./user"],
    // Prettierの設定ファイルを指定
  "prettier.configPath": "./user/.prettierrc.json",

  // 以下、各拡張子ごとに明示的に設定
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
}

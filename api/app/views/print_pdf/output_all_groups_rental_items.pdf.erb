<% @groups.each do |group| %>
<% fes_dates_by_day_num = group.fes_year.fes_dates.index_by(&:days_num) %>
<% day1_date = fes_dates_by_day_num[1]&.date %>
<% day2_date = fes_dates_by_day_num[2]&.date %>
<% pickup_date = fes_dates_by_day_num[0]&.date %>
<% return_date = fes_dates_by_day_num[3]&.date %>
<div class="page-break">
<h1><%= t('print_pdf.output_all_groups_rental_items.title') %></h1>

<div class="padding-top">
  <h2><%= t('print_pdf.output_all_groups_rental_items.sections.participating_org') %></h2>
  <table class="info">
    <tbody>
      <tr>
        <th><%= t('print_pdf.output_all_groups_rental_items.org.number') %></th>
        <td colspan=2><%= group.number %></td>
      </tr>
      <tr style="height:60px">
        <th><%= t('print_pdf.output_all_groups_rental_items.org.name') %></th>
        <td colspan=2><%= group.name %></td>
      </tr>
      <tr>
        <th><%= t('print_pdf.output_all_groups_rental_items.org.category') %></th>
        <td colspan=2><%= @use_english_name_for_pdf && group.group_category.name_en.present? ? group.group_category.name_en : group.group_category.name %></td>
      </tr>
      <tr>
        <th rowspan=2><%= t('print_pdf.output_all_groups_rental_items.org.activity_time') %></th>
        <td><%= day1_date %><%= t('print_pdf.output_all_groups_rental_items.org.day1_label') %></td>
        <td>10:00-17:00</td>
      </tr>
      <tr>
        <td><%= day2_date %><%= t('print_pdf.output_all_groups_rental_items.org.day2_label') %></td>
        <td>10:00-16:00</td>
      </tr>
      <tr>
        <th><%= t('print_pdf.output_all_groups_rental_items.org.location') %></th>
        <td colspan=2><%= group.place %></td>
      </tr>
      <tr>
        <th><%= t('print_pdf.output_all_groups_rental_items.org.power') %></th>
        <td colspan=2><%= group.sum_power_orders %> [W]</td>
      </tr>
    </tbody>
  </table>
</div>

<div class="padding-top">
  <h2><%= t('print_pdf.output_all_groups_rental_items.sections.rental_items') %></h2>
  <table class="items all-groups-items">
    <colgroup>
      <col class="item-name-column">
      <col class="pickup-location-column">
      <col class="quantity-column">
      <col class="remark-column">
      <col class="pickup-date-column">
      <col class="return-date-column">
      <col class="confirmation-column">
      <col class="confirmation-column">
    </colgroup>
    <tr>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.item_name') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.pickup_location') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.quantity') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.remark') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.pickup_date') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.return_date') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.pickup_confirmation') %></th>
      <th><%= t('print_pdf.output_all_groups_rental_items.items_table.headers.return_confirmation') %></th>
    </tr>
    <% group.assign_rental_items.each do |assign_rental_item| %>
    <tr>
      <td><%= @use_english_name_for_pdf && assign_rental_item.rental_item.name_en.present? ? assign_rental_item.rental_item.name_en : assign_rental_item.rental_item.name %></td>
      <td><%= @use_english_name_for_pdf && assign_rental_item.stocker_place.name_en.present? ? assign_rental_item.stocker_place.name_en : assign_rental_item.stocker_place.name %></td>
      <td><%= assign_rental_item.num %></td>
      <td><%= assign_rental_item.remark %></td>
      <td><span class="date-value"><%= pickup_date %></span><br><%= t('print_pdf.output_all_groups_rental_items.items_table.pickup_day_label') %></td>
      <td><span class="date-value"><%= return_date %></span><br><%= t('print_pdf.output_all_groups_rental_items.items_table.return_day_label') %></td>
      <td></td>
      <td></td>
    </tr>
    <% end %>
  </table>

  <br>
  <p>
  <%= t('print_pdf.output_all_groups_rental_items.precautions.title') %><br><br>
  <% Array(t('print_pdf.output_all_groups_rental_items.precautions.items')).each do |note| %>
    ● <%= note %><br>
  <% end %>
  </p>
</div>
</div>
<% end %>

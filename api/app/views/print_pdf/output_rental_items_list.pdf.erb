<% @catgories.each do |category| %>
  <% if category.exists? %>
    <% item_count = 0 %>
    <% page_items_limit = 18 %>
    <% is_new_page = true %>

    <% category.each do |group| %>
      <%# exists?/count は常にSQLを発行しプリロードを使わないため、any?/size を使う %>
      <% assign_rental_items = group.assign_rental_items %>
      <% group_items_count = assign_rental_items.any? ? assign_rental_items.size : 1 %>
      <% if item_count + group_items_count > page_items_limit || is_new_page %>
        <% if !is_new_page %>
          </table>
          </div>
        <% end %>
        <div class="page-break">
        <h1>貸し出し物品リスト - <%= category.first.group_category.name %></h1>
        <table>
          <tr>
            <th>参加形式</th>
            <th>団体番号</th>
            <th>団体名</th>
            <th>企画名</th>
            <th>名称</th>
            <th>在庫場所</th>
            <th>貸出場所</th>
            <th>個数</th>
            <th>備考欄</th>
          </tr>
        <% item_count = 0 %>
        <% is_new_page = false %>
      <% end %>
      <% item_count += group_items_count %>
      <tr>
        <td rowspan=<%= group_items_count %>><%= group.group_category.name %></td>
        <td rowspan=<%= group_items_count %>><%= group.number %></td>
        <td rowspan=<%= group_items_count %>><%= group.name %></td>
        <td rowspan=<%= group_items_count %>><%= group.project_name %></td>
        <% if assign_rental_items.any? %>
          <% assign_rental_items.each_with_index do |assign_rental_item, index| %>
            <% if index > 0 %><tr><% end %>
            <td><%= assign_rental_item.rental_item.name %></td>
            <td><%= assign_rental_item.stock_place_name %></td>
            <td><%= assign_rental_item.rental_place_name %></td>
            <td><%= assign_rental_item.num %></td>
            <td></td>
            </tr>
          <% end %>
        <% else %>
          <td colspan="4">なし</td>
        </tr>
        <% end %>
      <% end %>
      </table>
    </div>
  <% end %>
<% end %>

  %% References/correlations implemented in application code, without FK/model association.
  places -->|"APP LOOKUP first / second / third"| place_orders
  stages -.->|"stage_first / stage_second; Rails belongs_to only"| stage_orders

  %% Review status is coupled to eight positive application collections by group_id + application_type.
  health_center_submission_statuses -->|"APP STATE food_product + group_id"| food_products
  health_center_submission_statuses -->|"APP STATE purchase_list + group_id"| purchase_lists
  health_center_submission_statuses -->|"APP STATE cooking_process_order + group_id"| cooking_process_orders
  health_center_submission_statuses -->|"APP STATE employee + group_id"| employees
  health_center_submission_statuses -->|"APP STATE venue_map + group_id"| venue_maps
  health_center_submission_statuses -->|"APP STATE equipment + group_id"| rental_orders
  health_center_submission_statuses -->|"APP STATE power_order + group_id"| power_orders
  health_center_submission_statuses -->|"APP STATE fire_equipment_order + group_id"| fire_equipment_orders

  %% Negative answers are coupled to positive collections by group_id + order_type.
  un_registered_groups -->|"APP NEGATIVE sub_rep"| sub_reps
  un_registered_groups -->|"APP NEGATIVE rental_item_order"| rental_orders
  un_registered_groups -->|"APP NEGATIVE power_order"| power_orders
  un_registered_groups -->|"APP NEGATIVE employee"| employees
  un_registered_groups -->|"APP NEGATIVE fire_equipment_order"| fire_equipment_orders

  %% Allocation/stock are reconciled by shared keys rather than a persisted parent ID.
  rental_orders -->|"APP RECONCILE group_id + rental_item_id"| assign_rental_items
  stocker_items -->|"APP RECONCILE rental_item_id + stocker_place_id"| assign_rental_items

  %% The legacy admin fallback reads assign_rental_items.rental_order_id/rentable_item_id,
  %% but neither column exists. It is intentionally not represented as a relationship.

  %% Schema/model mismatch: application code uses contact_people.group_id, while the Model declares the reverse.
  groups -->|"APP LOOKUP contact_people.group_id; no belongs_to"| contact_people
  contact_people -.->|"BROKEN RAILS has_many expects missing groups.contact_person_id"| groups

  legend_db["THICK = DB-enforced"]
  legend_model["DOTTED = Rails-only"]
  legend_lookup["THIN = manual lookup / business correlation"]
  legend_unconfirmed["UNCONFIRMED = no edge until runtime/data evidence"]

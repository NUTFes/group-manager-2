  %% Eight relationships that the database actually enforces.
  stocker_places ==>|"DB FK rental_place_id"| assign_rental_items
  food_products ==>|"DB FK food_product_id; has_one no UNIQUE; same-group not enforced"| cooking_process_orders
  groups ==>|"DB FK group_id; has_one no UNIQUE; same-group not enforced"| cooking_process_orders
  groups ==>|"DB FK group_id"| fire_equipment_orders
  stocker_places ==>|"DB FK uses_place_id"| groups
  groups ==>|"DB FK group_id"| health_center_submission_statuses
  groups ==>|"DB FK group_id"| un_registered_groups
  users ==>|"DB FK user_id; AR has_one but no UNIQUE"| user_details


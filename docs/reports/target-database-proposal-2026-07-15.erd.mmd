erDiagram
  %% Proposal version date: 2026-07-15.
  %% Proposed steady-state logical schema: 78 runtime tables.
  %% This is a design proposal, not current DDL. Unresolved gates are documented in
  %% database-erd-current-and-target-2026-07-15.md and must be closed before migrations are authored.
  %% Conventions: bigint PKs; UTC datetime(6); utf8mb4; every FK indexed; required FKs NOT NULL.
  %% Mutable records have created_at/updated_at; aggregate roots have lock_version.
  %% Composite UNIQUE/FK and CHECK constraints are stated in comments where Mermaid cannot draw them.

  users {
    bigint id PK
    string email_normalized UK "NOT NULL"
    string provider "NOT NULL"
    string uid "NOT NULL; UNIQUE(provider,uid)"
    string encrypted_password "NOT NULL"
    string name "NOT NULL"
    string status "active locked archived"
    datetime confirmed_at
    datetime archived_at
    integer lock_version "NOT NULL default 0"
  }
  user_profiles {
    bigint id PK
    bigint user_id FK, UK "NOT NULL"
    bigint department_id FK
    bigint grade_id FK
    string tel "PII"
    string student_id "PII"
  }
  departments {
    bigint id PK
    string key UK "NOT NULL"
    string name_ja "NOT NULL"
    string name_en
    datetime archived_at
  }
  grades {
    bigint id PK
    string key UK "NOT NULL"
    string name_ja "NOT NULL"
    string name_en
    datetime archived_at
  }
  roles {
    bigint id PK
    string key UK "NOT NULL"
    string name "NOT NULL"
    datetime archived_at
  }
  capabilities {
    bigint id PK
    string key UK "NOT NULL"
    string description
  }
  role_capabilities {
    bigint id PK
    bigint role_id FK "NOT NULL; UNIQUE(role_id,capability_id)"
    bigint capability_id FK "NOT NULL"
  }
  user_role_assignments {
    bigint id PK
    bigint user_id FK "NOT NULL; UNIQUE(user_id,role_id,active_slot)"
    bigint role_id FK "NOT NULL"
    bigint granted_by_user_id FK "NOT NULL"
    datetime active_from "NOT NULL"
    datetime active_until
    string active_slot "active row = active; historical row = NULL"
  }
  access_sessions {
    bigint id PK
    bigint user_id FK "NOT NULL"
    string audience "user admin"
    string token_digest UK "NOT NULL; raw token forbidden"
    datetime idle_expires_at "NOT NULL"
    datetime absolute_expires_at "NOT NULL"
    integer rotation_version "NOT NULL default 0"
    datetime last_used_at
    datetime revoked_at
  }
  password_recovery_tokens {
    bigint id PK
    bigint user_id FK "NOT NULL"
    string token_digest UK "NOT NULL; raw token forbidden"
    string purpose "reset confirm"
    datetime expires_at "NOT NULL"
    datetime used_at
  }

  festival_years {
    bigint id PK
    integer year_num UK "NOT NULL; ID never reseeded"
    string lifecycle "draft active closed archived"
    string active_slot UK "active year = active; other rows = NULL"
    datetime opened_at
    datetime closed_at
    datetime archived_at
    integer lock_version "NOT NULL default 0"
  }
  festival_dates {

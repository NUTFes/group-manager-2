    bigint withdrawn_by_membership_id FK "composite FK (membership,participation)"
    bigint idempotency_record_id FK "native submitted NOT NULL and UNIQUE; legacy import NULL"
    integer version_number "NOT NULL"
    string state "draft submitted withdrawn"
    string draft_slot "current draft = current; other rows = NULL"
    string response_kind "provided no_request; NULL only for unselected draft"

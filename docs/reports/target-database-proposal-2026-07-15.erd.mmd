    string detail_kind "NOT NULL"
    datetime retired_at
  }
  application_requirement_versions {
    bigint id PK
    bigint application_requirement_id FK "NOT NULL; UNIQUE(requirement,version); UNIQUE(id,requirement)"
    integer version_number "NOT NULL"
    string schema_version "NOT NULL"
    string eligibility_policy_key "NOT NULL"
    integer eligibility_policy_version "NOT NULL"
    string review_policy_key "NOT NULL"
    integer review_policy_version "NOT NULL"
    string review_scope "none submission item both"
    string submission_policy_key "NOT NULL"
    integer submission_policy_version "NOT NULL"
    string withdrawal_policy_key "NOT NULL"
    integer withdrawal_policy_version "NOT NULL"
    string product_reference_policy "draft_allowed submitted effective or NULL"
    boolean allow_no_request "NOT NULL"
    integer min_items "CHECK >= 0"
    integer max_items "CHECK max >= min"
    datetime opens_at
    datetime due_at "CHECK due > opens"
  }
  application_requirement_publications {
    bigint application_requirement_id PK, FK
    bigint current_version_id FK, UK "NOT NULL; version must belong to requirement"
